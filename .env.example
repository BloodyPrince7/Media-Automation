# ============================================
# Social Media Automation Configuration
# ============================================

# Mode: Set to "true" to test publishing, scheduling, and UI without real credentials.
# Set to "false" when you want to make actual live calls to X and LinkedIn APIs.
MOCK_MODE=true

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
DATABASE_URL=sqlite:///./automation.db

# --------------------------------------------
# X (Twitter) API v2 Credentials
# Get these from https://developer.x.com/en/portal/dashboard
# --------------------------------------------
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# --------------------------------------------
# LinkedIn API Credentials
# Get these from https://www.linkedin.com/developers/
# (Requires 'Share on LinkedIn' and 'Sign In with LinkedIn using OpenID Connect' or w_member_social permissions)
# --------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
# Author URN format: urn:li:person:XXXXXXX or urn:li:organization:XXXXXXX
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id_here

# --------------------------------------------
# Instagram Graph API Credentials (Meta Professional Account)
# Get these from https://developers.facebook.com/
# --------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# --------------------------------------------
# Optional: Google Gemini API (for AI Content Enhancement)
# Get a free key at https://aistudio.google.com/
# --------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

